# Ingestion Service Environment Configuration

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_RAW_TOPIC=social.engagement.raw
KAFKA_CONSUMER_GROUP=ingestion-service-group

# MinIO Data Lake Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=socialtrend-datalake
MINIO_USE_SSL=false

# REST Fallback Server Configuration
HTTP_PORT=8081

# Optional: Path to contracts/kafka directory
# CONTRACTS_KAFKA_DIR=../../contracts/kafka
